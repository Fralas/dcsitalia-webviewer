# Server Configuration
NODE_ENV=development
PORT=3001

# CSV Files Directory
# Path to the directory containing airport CSV files
# Can be absolute or relative to the backend directory
# Default: project root (../../ from backend/src/)
# Example: /path/to/your/csv/files or ./data/csv
CSV_DIR=

# Security
JWT_SECRET=generate-a-long-random-string-at-least-32-chars
SESSION_SECRET=another-long-random-string-at-least-32-chars
# Generate with: npm run security:hash-password -- "your-admin-password"
ADMIN_PASSWORD_HASH=
# Dev only (plaintext is hashed in memory; forbidden in production):
# ADMIN_PASSWORD=your-admin-password-here

# JSON body limits (default 1mb; media/logo routes use the large limit)
# JSON_BODY_LIMIT=1mb
# JSON_BODY_LARGE_LIMIT=16mb

# CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Session
SESSION_TIMEOUT=24h

# App state (wiki, LIDC, ATC, missions, sessions). JSON files are imported once if present.
# SQLITE_PATH=data/app.sqlite
# Online backup: npm run data:backup
# Restore (server stopped): npm run data:restore -- data/backups/app-….sqlite

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback

# Temporary local auth bypass (development only — never enable in production)
# When true + NODE_ENV=development, injects a Local Dev session user without Discord OAuth.
AUTH_BYPASS_LOCAL=true

# Discord allowlists (comma-separated user IDs). Required in production; optional in development.
# DISCORD_LIDC_IDS=675706661570347041
# DISCORD_ATC_IDS=675706661570347041,371212324054237206
# CHANGELOG_AUTHOR_IDS=
# WIKI_EDITOR_IDS=
# NOE_AUTHOR_IDS=
# Optional Discord role IDs (guild member roles from DISCORD_BOT_TOKEN):
# DISCORD_LIDC_ROLE_ID=
# DISCORD_ATC_ROLE_ID=
# DISCORD_WIKI_EDITOR_ROLE_ID=
# DISCORD_NOE_EDITOR_ROLE_ID=
# DISCORD_CHANGELOG_AUTHOR_ROLE_ID=

# Discord role-gated logistics route visibility
DISCORD_GUILD_ID=your-discord-guild-id
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_LOGISTICS_ROUTE_ROLE_ID=your-discord-role-id

# External Convoy API (Lua -> backend)
CONVOY_API_TOKEN=your-convoy-api-token
# CONVOY_SYNC_FILE=
# DCSAR_SYNC_FILE=
# AIRLIFT_PLAYERS_SYNC_FILE=
# PRODUCTION_POINTS_FILE=
# DSCORE_SCORE_FILE=
# HIDC_LOGISTICS_ORDERS_FILE=C:\DCS SERVER\MISSION SCRIPTS\DCORE\src\DSCORE\Export_WebLogistics_Orders.json
# WEB_COMMANDS_FILE=C:\DCS SERVER\MISSION SCRIPTS\DCORE\src\DBRIDGE\Export_WebCommands.json
# WEB_COMMANDS_RESULT_FILE=C:\DCS SERVER\MISSION SCRIPTS\DCORE\src\DBRIDGE\Export_WebCommands_Result.json
# WEB_SPAWN_MARKERS_FILE=C:\DCS SERVER\MISSION SCRIPTS\DCORE\src\DBRIDGE\Export_WebSpawn_Markers.json
# DBUILD_SITES_FILE=C:\DCS SERVER\MISSION SCRIPTS\DCORE\src\DBRIDGE\Export_DBUILD_Sites.json
# TANKER_ROUTES_FILE=C:\DCS SERVER\MISSION SCRIPTS\DCORE\src\DBRIDGE\Export_Tanker_Routes.json
# SHIP_POSITIONS_FILE=C:\DCS SERVER\MISSION SCRIPTS\DCORE\src\DBRIDGE\Export_Ship_Positions.json
# AIRBASE_STATUS_FILE=
# DCORE_LIDC_DBRIDGE_DIR=

# HIDC pilot link / XP / region votes (services/hidcCampaign.js).
# Paths default to DCORE src/DBRIDGE (inferred from WEB_COMMANDS_FILE) and src/DMAP.
# HIDC_PILOT_LINK_REQUESTS_FILE=C:\DCS SERVER\MISSION SCRIPTS\DCORE\src\DBRIDGE\Export_Pilot_LinkRequests.json
# HIDC_PILOT_STATS_FILE=C:\DCS SERVER\MISSION SCRIPTS\DCORE\src\DBRIDGE\Export_Pilot_Stats.json
# Sling-load logistics per pilot (DBRIDGE_Cargo.lua), merged by UCID with DCSServerBot stats.
# HIDC_PILOT_CARGO_FILE=C:\DCS SERVER\MISSION SCRIPTS\DCORE\src\DBRIDGE\Export_Pilot_Cargo.json
# HIDC_FOCUS_FILE=C:\DCS SERVER\MISSION SCRIPTS\DCORE\src\DMAP\Export_DCampaign_Focus.json
# HIDC_REGION_STATUS_FILE=C:\DCS SERVER\MISSION SCRIPTS\DCORE\src\DMAP\Export_DRegion_Status.json
# Region vote: opens by itself when no region is active (after a conquest), or is started from the map
# by a pilot of level >= HIDC_VOTE_MIN_LEVEL (change of active region). Each pilot picks the region to
# attack and the BLUE region to attack from.
# Min level to start a vote, min level to vote, round length (minutes; an automatic round is extended
# while nobody votes), wait between pilot-started rounds (minutes), retry delay after DCS rejected the winner (minutes).
# HIDC_VOTE_MIN_LEVEL=5
# HIDC_VOTE_MIN_VOTER_LEVEL=0
# HIDC_VOTE_DURATION_MIN=120
# HIDC_VOTE_COOLDOWN_MIN=60
# Ballots needed for a valid round (below it: automatic round extended, pilot-started round closes, region unchanged)
# HIDC_VOTE_MIN_VOTES=3
# HIDC_VOTE_RETRY_MIN=10
# Discord ids allowed to start and vote below the min levels (comma separated), e.g. staff or testers
# HIDC_VOTE_LEVEL_BYPASS_IDS=
# Missioni HIDC (pannello Missione): una per zona della regione attiva.
# SEAD se la zona ha SEAD; DEAD se ha DEAD (anche con CAS); CAS se ha solo CAS; LOGISTICS se la zona e' vuota (bianca).
# Completata quando la task non e' piu' attiva (LOGISTICS: la zona diventa BLUE) entro la durata, se il pilota ha volato dopo averla accettata.
# HIDC_MISSION_DURATION_MIN=120
# HIDC_MISSION_MAX_ACTIVE=1
# HIDC_MISSION_CONFIRM_SEC=90
# HIDC_MISSION_REQUIRE_FLIGHT=true
# HIDC_MISSION_XP_SEAD=60
# HIDC_MISSION_XP_DEAD=50
# HIDC_MISSION_XP_CAS=40
# HIDC_MISSION_XP_LOGISTICS=40
# Missioni logistiche IA (tab Logistica): CH-47 / C-130 IA tra due aeroporti BLUE, volate da DCORE DBRIDGE_AirLift.lua.
# Costo = base del mezzo + COST_PER_UNIT per munizione (nessun limite di carico). Il C-130 non usa eliporti/FARP.
# HIDC_AIRLIFT_CH47_MIN_LEVEL=6
# HIDC_AIRLIFT_C130_MIN_LEVEL=25
# HIDC_AIRLIFT_CH47_BASE_COST=50
# HIDC_AIRLIFT_C130_BASE_COST=120
# HIDC_AIRLIFT_COST_PER_UNIT=0.5
# Stato voli e luoghi di schianto (default: <cartella DBRIDGE>/Export_AirLift.json)
# HIDC_AIRLIFT_STATE_FILE=
# Solo test (ignorato in produzione): livello forzato per id Discord, "id:livello,id:livello"
# HIDC_LEVEL_OVERRIDES=
# Discord channel where the bot announces votes (uses DISCORD_BOT_TOKEN). Leave empty to disable.
# HIDC_VOTE_CHANNEL_ID=

# DCSServerBot (services/dcsServerBot.js). When set, it replaces the DCORE pilot tracker:
# link = the bot's /linkme (players.discord_id), XP and stats from its statistics table.
# Use the read-only role from scripts/dcsserverbot-readonly.sql (SELECT only).
# DCSSB_DATABASE_URL=postgres://hidc_web_ro:CHANGE_ME@127.0.0.1:5432/dcsserverbot
# Only count missions of these DCSServerBot servers (missions.server_name, comma separated). Empty = all.
# DCSSB_SERVER_NAMES=
# DCSSB_REFRESH_SEC=60
# DCSSB_MAX_SESSION_H=12
# XP with DCSServerBot: per minute in slot, per landed sortie, level curve floor(base * L^exp), L = 0..max
# HIDC_XP_PER_MINUTE=1
# HIDC_XP_PER_SORTIE=10
# HIDC_LEVEL_MAX=100
# Default 60 / 1: one level per hour in slot (60 XP), level 100 = 100 h
# HIDC_LEVEL_XP_BASE=60
# HIDC_LEVEL_XP_EXP=1

# Carto basemaps (server-side tile proxy — do not expose this key to the frontend)
CARTO_BASEMAP_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
