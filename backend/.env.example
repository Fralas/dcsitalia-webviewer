# Server Configuration
NODE_ENV=development
PORT=3001

# CSV Files Directory
# Path to the directory containing airport CSV files
# Can be absolute or relative to the backend directory
# Default: project root (../../ from backend/src/)
# Example: /path/to/your/csv/files or ./data/csv
CSV_DIR=

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ADMIN_PASSWORD=your-admin-password-here
SESSION_SECRET=your-session-secret-change-this-in-production

# CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Session
SESSION_TIMEOUT=24h

# App state (wiki, LIDC, ATC, missions, sessions). JSON files are imported once if present.
# SQLITE_PATH=data/app.sqlite
# Online backup: npm run data:backup
# Restore (server stopped): npm run data:restore -- data/backups/app-….sqlite

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback

# Temporary local auth bypass (development only — never enable in production)
# When true + NODE_ENV=development, injects a Local Dev session user without Discord OAuth.
AUTH_BYPASS_LOCAL=true

# Discord role-gated logistics route visibility
DISCORD_GUILD_ID=your-discord-guild-id
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_LOGISTICS_ROUTE_ROLE_ID=your-discord-role-id
LOGISTICS_ROUTE_VISIBILITY_FILE=dcsitalia-webviewer\logistics-route-visibility.json

# External Convoy API (Lua -> backend)
CONVOY_API_TOKEN=your-convoy-api-token
# Local convoy export file from DCS mission scripts
CONVOY_SYNC_FILE=C:\DCS SERVER\MISSION SCRIPTS\DCORE\src\DMAP\Export_Ground_Convoys.json
# Local DCSAR export file (line-based coordinates)
DCSAR_SYNC_FILE=C:\DCS SERVER\MISSION SCRIPTS\DCORE\src\DMAP\Export_DCSAR_Positions.json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
