# Server Configuration
NODE_ENV=development
PORT=3001

# CSV Files Directory
# Path to the directory containing airport CSV files
# Can be absolute or relative to the backend directory
# Default: project root (../../ from backend/src/)
# Example: /path/to/your/csv/files or ./data/csv
CSV_DIR=

# Security
JWT_SECRET=generate-a-long-random-string-at-least-32-chars
SESSION_SECRET=another-long-random-string-at-least-32-chars
# Generate with: npm run security:hash-password -- "your-admin-password"
ADMIN_PASSWORD_HASH=
# Dev only (plaintext is hashed in memory; forbidden in production):
# ADMIN_PASSWORD=your-admin-password-here

# JSON body limits (default 1mb; media/logo routes use the large limit)
# JSON_BODY_LIMIT=1mb
# JSON_BODY_LARGE_LIMIT=16mb

# CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Session
SESSION_TIMEOUT=24h

# App state (wiki, LIDC, ATC, missions, sessions). JSON files are imported once if present.
# SQLITE_PATH=data/app.sqlite
# Online backup: npm run data:backup
# Restore (server stopped): npm run data:restore -- data/backups/app-….sqlite

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback

# Temporary local auth bypass (development only — never enable in production)
# When true + NODE_ENV=development, injects a Local Dev session user without Discord OAuth.
AUTH_BYPASS_LOCAL=true

# Discord allowlists (comma-separated user IDs). Required in production; optional in development.
# DISCORD_LIDC_IDS=675706661570347041
# DISCORD_ATC_IDS=675706661570347041,371212324054237206
# CHANGELOG_AUTHOR_IDS=
# WIKI_EDITOR_IDS=
# NOE_AUTHOR_IDS=
# Optional Discord role IDs (guild member roles from DISCORD_BOT_TOKEN):
# DISCORD_LIDC_ROLE_ID=
# DISCORD_ATC_ROLE_ID=
# DISCORD_WIKI_EDITOR_ROLE_ID=
# DISCORD_NOE_EDITOR_ROLE_ID=
# DISCORD_CHANGELOG_AUTHOR_ROLE_ID=

# Discord role-gated logistics route visibility
DISCORD_GUILD_ID=your-discord-guild-id
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_LOGISTICS_ROUTE_ROLE_ID=your-discord-role-id

# External Convoy API (Lua -> backend)
CONVOY_API_TOKEN=your-convoy-api-token
# CONVOY_SYNC_FILE=
# DCSAR_SYNC_FILE=
# AIRLIFT_PLAYERS_SYNC_FILE=
# PRODUCTION_POINTS_FILE=
# DSCORE_SCORE_FILE=
# WEB_COMMANDS_FILE=
# WEB_COMMANDS_RESULT_FILE=
# WEB_SPAWN_MARKERS_FILE=
# DBUILD_SITES_FILE=
# TANKER_ROUTES_FILE=
# AIRBASE_STATUS_FILE=
# DCORE_LIDC_DBRIDGE_DIR=

# Carto basemaps (server-side tile proxy — do not expose this key to the frontend)
CARTO_BASEMAP_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
